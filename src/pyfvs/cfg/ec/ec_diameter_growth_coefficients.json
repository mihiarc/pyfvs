{
  "_metadata": {
    "variant": "EC",
    "variant_name": "FVS East Cascades",
    "source": "FVS EC variant dgf.f and blkdat.f (ForestVegetationSimulator/ec/)",
    "num_species": 32,
    "native_cycle_years": 10,
    "equation_form_ec_native": "ln(DDS) = CONSPP + DGLD*ln(D) + DGDUM*dummy + CR*(DGCR + CR*DGCRSQ) + DGDSQ*D^2 + DGDBAL*BAL/ln(D+1) + DGPCCF*PCCF + DGHCCF*RELHT*PCCF/100 + DGCCFA*PCCF^2/1000",
    "equation_form_wc_derived": "ln(DDS) = CONSPP + DGLD*ln(D) + CR*(DGCR + CR*DGCRSQ) + DGDSQ*D^2 + DGDBAL*BAL/ln(D+1) + DGPCCF*PCCF + DGBA*BA",
    "equation_form_red_alder": "Special equation: DDS = ln(DIAGR*(2*D*BARK+DIAGR)) where DIAGR is a function of BA, D",
    "conspp": "CONSPP = DGFOR(MAPLOC(IFOR,ISPC)) + DGEL*ELEV + DGEL2*ELEV^2 + DGSITE*ln(SITE) + (DGSASP*sin(ASP) + DGCASP*cos(ASP) + DGSLOP)*SLOPE + DGSLSQ*SLOPE^2 + COR(species). When SLOPE=0 and species is EC-native, SASP = SL0DUM.",
    "dummy_variable": "Dummy=1.0 for species 4 (SF), 6 (GF), 16 (WF); 0.0 otherwise",
    "species_specific_tweaks": [
      "WP (idx 1): adds 0.49649*RELHT to DDS",
      "AF (idx 9): adds 0.3835 to DGCON",
      "WH (idx 11): subtracts 0.000358*RELHT from DDS",
      "MH (idx 12), OS (idx 31): SI multiplied by 3.281",
      "WO (idx 28): SI transformed to 1-(SI/114.24569)^.4444 then -37.60812*ln",
      "WO (idx 28): subtracts 0.00326*BAL from DDS",
      "MH (12), OS (31): CONSPP -= 0.000021*RMAI*RELDEN",
      "WJ (19), PB-OH (23-27, 29, 30, 32): elevation capped at 30"
    ],
    "stochastic_clip": "DDS clipped at >= -9.21 (oc/dgf.f:562 equivalent)"
  },
